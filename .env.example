ARK_KEY=your-ark-api-key
ARK_MODEL=doubao-seed-1-8-251228
EMBEDDER=your-ark-embedding-model-or-endpoint-id
# 可选：text、multi_modal。留空时 vision 模型会自动使用 multi_modal。
EMBEDDER_API_TYPE=text

# MySQL
MYSQL_DATABASE=go_agentery
MYSQL_USER=go_agentery
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Redis
REDIS_PASSWORD=change-redis-password
REDIS_DB=0

# Chat context
HISTORY_CONTEXT_LIMIT=40

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ANALYTICS_MYSQL_DSN=go_analytics_ro:go_analytics_ro@tcp(127.0.0.1:13306)/go_agentery?charset=utf8mb4&parseTime=True&loc=Local

# Optional overrides
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
